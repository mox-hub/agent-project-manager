# Agent Project Manager Desktop - 环境变量配置示例

# 后端端口（默认 4300）
PORT=4300

# API 基础 URL
API_BASE_URL=http://127.0.0.1:4300

# 数据库路径（相对于用户数据目录）
# DATABASE_PATH=agent-project-manager.db

# JWT 密钥（自动生成，如需自定义请设置）
# JWT_SECRET=your-secret-key-here

# Node 环境
NODE_ENV=production

# 应用模式
APP_MODE=standalone

# 日志级别
# RUST_LOG=info
