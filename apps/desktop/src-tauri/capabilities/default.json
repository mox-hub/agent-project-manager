{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for Agent Project Manager Desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "log:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-message",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "os:default",
    "process:allow-exit"
  ]
}
