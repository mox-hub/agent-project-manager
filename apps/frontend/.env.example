# For local dev, Vite proxy will forward /_api -> http://localhost:4300
# Leave empty to use the Vite proxy (requests go through /_api).
# Set to a backend origin (with or without trailing /_api) to bypass the proxy;
# the api client will append /_api automatically to match the NestJS global prefix.
VITE_API_BASE_URL=http://localhost:4300
VITE_WS_URL=ws://localhost:4300

# Boot startup screen switch.
# When true, the user is shown a /boot page that runs init checks before login.
# When false, the user lands directly on /login.
VITE_SHOW_STARTUP_SCREEN=false
# Whether the current run is a first-time launch.
# Drives headline copy ("initializing" vs "quick launch") and step ordering.
VITE_FIRST_RUN=false
