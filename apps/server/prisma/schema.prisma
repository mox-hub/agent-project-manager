generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Seed configuration

// Phase1 Core
model AppConfig {
  id          String   @id @default(cuid())
  key         String
  value       Json
  scope       String
  projectId   String?
  userId      String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  @@index([key, scope], name: "idx_app_configs_key_scope")
  @@index([projectId], name: "idx_app_configs_project_id")
  @@index([userId], name: "idx_app_configs_user_id")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  projectId    String?
  ipAddress    String?
  userAgent    String?
  oldValue     Json?
  newValue     Json?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt], name: "idx_audit_logs_actor_id_created_at")
  @@index([projectId], name: "idx_audit_logs_project_id")
  @@index([resourceType, resourceId], name: "idx_audit_logs_resource")
}

model SystemEvent {
  id        String   @id @default(cuid())
  level     String
  category  String
  message   String
  context   Json?
  createdAt DateTime @default(now())

  @@index([level, createdAt], name: "idx_system_events_level_created_at")
  @@index([category, createdAt], name: "idx_system_events_category_created_at")
}

// Phase1 User/Auth (minimal schema foundation; relations can be added later)
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  email        String?  @unique
  passwordHash String?
  authProvider String
  avatarUrl    String?
  timezone     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions        Session[]
  roleAssignments RoleAssignment[]
  oauthAccounts   OAuth2Account[]
  agentIdentityBindings AgentIdentityBinding[] @relation("AgentIdentityCreatedBy")
  projectMembers  ProjectMember[]
  ownedProjects   Project[]       @relation("ProjectOwner")
  assignedTasks   Task[]           @relation("TaskAssignee")
  reportedTasks   Task[]           @relation("TaskReporter")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  lastActiveAt DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  metadata     Json?

  user User @relation(fields: [userId], references: [id])

  @@index([userId], name: "idx_sessions_user_id")
  @@index([expiresAt], name: "idx_sessions_expires_at")
}

model RoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  scopeType String
  projectId String?
  role      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, scopeType, projectId, role])
  @@index([userId, scopeType, projectId], name: "idx_role_assignments_user_scope")
}

model OAuth2Provider {
  id           String   @id @default(cuid())
  name         String   @unique
  issuer       String?
  authUrl      String
  tokenUrl     String
  userinfoUrl  String?
  clientId     String
  clientSecret String
  redirectUris Json?
  scopes       Json?
  enabled      Boolean  @default(true)
  config       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts OAuth2Account[]
}

model OAuth2Account {
  id               String    @id @default(cuid())
  userId           String
  providerId       String
  externalUserId   String
  externalUsername String?
  email            String?
  accessToken      String?
  refreshToken     String?
  expiresAt        DateTime?
  scopes           Json?
  rawProfile       Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user     User           @relation(fields: [userId], references: [id])
  provider OAuth2Provider @relation(fields: [providerId], references: [id])

  @@unique([providerId, externalUserId])
  @@index([userId], name: "idx_oauth2_accounts_user_id")
}

model AgentIdentityBinding {
  id             String   @id @default(cuid())
  projectId      String
  subjectType    String
  subjectId      String
  providerId     String
  identitySource String
  mappedRole     String?
  mappedLevel    String?
  status         String   @default("active")
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  metadata       Json?

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUser User?   @relation("AgentIdentityCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([projectId, subjectType, subjectId], name: "uniq_agent_identity_project_subject")
  @@index([projectId], name: "idx_agent_identity_project_id")
  @@index([providerId], name: "idx_agent_identity_provider_id")
  @@index([status], name: "idx_agent_identity_status")
}

model ActorClaimSnapshot {
  id                String   @id @default(cuid())
  projectId         String?
  subjectType       String
  subjectId         String
  identitySource    String
  projectScopes     Json?
  permissionProfile Json?
  issuedAt          DateTime @default(now())
  expiresAt         DateTime
  issuedBy          String?
  metadata          Json?

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([subjectType, subjectId], name: "idx_actor_claim_subject")
  @@index([projectId], name: "idx_actor_claim_project_id")
  @@index([expiresAt], name: "idx_actor_claim_expires_at")
}

// Phase1 Project-Metadata foundation
model Tag {
  id            String   @id @default(cuid())
  projectId     String?
  name          String
  color         String?
  description   String?
  resourceTypes Json?
  createdAt     DateTime @default(now())
  createdBy     String?
  metadata      Json?

  taskTags    TaskTag[]
  documents   DocumentTag[]

  @@index([projectId], name: "idx_tags_project_id")
  @@index([name, projectId], name: "idx_tags_name_project")
}

/// 文档-标签多对多关联
model DocumentTag {
  documentId String
  tagId      String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@index([tagId], name: "idx_document_tags_tag_id")
  @@index([documentId], name: "idx_document_tags_document_id")
}

model StatusDefinition {
  id                    String  @id @default(cuid())
  projectId             String?
  type                  String
  key                   String
  name                  String
  order                 Int
  isFinal               Boolean @default(false)
  isBlockedState        Boolean @default(false)
  allowedNextStatusKeys Json?
  metadata              Json?

  @@unique([projectId, type, key])
  @@index([projectId, type], name: "idx_status_def_project_type")
}

model ProjectRoleDefinition {
  id                 String  @id @default(cuid())
  projectId          String?
  key                String
  name               String
  description        String?
  defaultAssigneeIds Json?
  metadata           Json?

  @@unique([projectId, key])
  @@index([projectId], name: "idx_project_roles_project_id")
}

model ProjectTemplate {
  id                String   @id @default(cuid())
  name              String
  description       String?
  baseProjectType   String?
  defaultTags       Json?
  defaultStatuses   Json?
  defaultIterations Json?
  defaultTasks      Json?
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  metadata          Json?

  @@index([name], name: "idx_project_templates_name")
}

// Phase2 Project core models
model Project {
  id             String    @id @default(cuid())
  name           String
  description    String?
  projectCode    String?   @unique
  icon           String?
  color          String?   @default("#5E6AD2")
  type           String // 'personal' | 'team' | 'experiment' | 'enterprise'
  visibility     String // 'private' | 'internal' | 'public'
  status         String // 'active' | 'archived'
  source         String    @default("local") // 'local' | 'github_projects' | 'linear' | 'jira'
  priority       String    @default("medium") // 'low' | 'medium' | 'high' | 'urgent'
  workflowStatus String    @default("planned") // 'backlog' | 'planned' | 'in_progress' | 'completed' | 'canceled'
  healthStatus   String    @default("at_risk") // 'on_track' | 'at_risk' | 'off_track'
  riskLevel      String    @default("medium") // 'low' | 'medium' | 'high' | 'critical'
  progress       Int       @default(0)
  ownerId        String?
  startDate      DateTime?
  targetDate     DateTime?
  completedAt    DateTime?
  category       String?
  estimatePoints Int?
  lastActivityAt DateTime?
  blockedReason  String?
  healthScore    Int       @default(50)
  config         Json?
  documentsRepoPath String?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members         ProjectMember[]
  owner           User?             @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  iterations      Iteration[]
  milestones      Milestone[]
  tasks           Task[]
  activities      TaskActivity[]
  taskTemplates   TaskTemplate[]
  aiConversations AIConversation[]
  aiWorkflowRuns  AIWorkflowRun[]
  agentIdentityBindings AgentIdentityBinding[]
  actorClaimSnapshots   ActorClaimSnapshot[]
  repositories    Repository[]
  terminalSessions TerminalSession[]
  workspace       ProjectWorkspace?
  modules         ProjectModule[]
  sequence        ProjectSequence?
  externalLinks   ExternalProjectLink[]
  docLinks        ProjectDocLink[]
  apiDocLinks    ProjectApiDocLink[]
  healthSnapshots ProjectHealthSnapshot[]
  aiContext       ProjectAIContext?
  executionRuns   ExecutionRun[]
  approvals       ApprovalRequest[]
  documents       Document[]

  @@index([status], name: "idx_projects_status")
  @@index([createdBy], name: "idx_projects_created_by")
  @@index([visibility, status], name: "idx_projects_visibility_status")
  @@index([source], name: "idx_projects_source")
  @@index([priority], name: "idx_projects_priority")
  @@index([workflowStatus], name: "idx_projects_workflow_status")
  @@index([riskLevel], name: "idx_projects_risk_level")
  @@index([ownerId], name: "idx_projects_owner_id")
  @@index([targetDate], name: "idx_projects_target_date")
  @@index([lastActivityAt], name: "idx_projects_last_activity_at")
}

model ProjectMember {
  projectId String
  userId    String
  role      String // 'owner' | 'maintainer' | 'member' | 'guest'
  joinedAt  DateTime @default(now())
  metadata  Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId], name: "idx_project_members_user_id")
}

model Iteration {
  id        String   @id @default(cuid())
  projectId String
  name      String
  goal      String?
  startDate DateTime
  endDate   DateTime
  capacity  Int?
  status    String // 'planned' | 'active' | 'completed' | 'cancelled'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks      Task[]
  milestones Milestone[]

  @@index([projectId], name: "idx_iterations_project_id")
  @@index([projectId, status], name: "idx_iterations_project_id_status")
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  iterationId String?
  name        String
  description String?
  targetDate  DateTime?
  status      String // 'planned' | 'in_progress' | 'reached' | 'missed' | 'cancelled'
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  iteration Iteration?      @relation(fields: [iterationId], references: [id], onDelete: SetNull)
  tasks     MilestoneTask[]

  @@index([projectId], name: "idx_milestones_project_id")
  @@index([projectId, status], name: "idx_milestones_project_id_status")
  @@index([iterationId], name: "idx_milestones_iteration_id")
}

model MilestoneTask {
  milestoneId String
  taskId      String
  projectId   String
  metadata    Json?

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([milestoneId, taskId])
  @@index([taskId], name: "idx_milestone_tasks_task_id")
}

model Task {
  id           String    @id @default(cuid())
  projectId    String
  iterationId  String?
  parentTaskId String?
  title        String
  description  String?
  status       String // 对应 StatusDefinition.key
  priority     String // 'low' | 'medium' | 'high' | 'critical'
  assigneeId   String?
  assigneeType String   @default("user") // 'user' | 'ai_agent'
  aiAgentId    String?
  reporterId   String?
  startDate    DateTime?
  dueDate      DateTime?
  estimate     Int?
  actualSpent  Int?
  aiSuggestion Json?
  aiExecutionSpec   Json?
  aiExecutionResult Json?
  aiExecutionStatus String? // 'pending' | 'running' | 'completed' | 'failed'
  gitRefs      Json?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Task/Bug 类型区分
  type              String   @default("task") // 'task' | 'bug'

  // 短 ID (Phase 4): 例如 "APM-PF-001", 跨 task/bug 共享计数器
  shortId           String?  @unique

  // Bug 专用字段
  severity           String?  // 'critical' | 'high' | 'medium' | 'low'
  bugReproducibility String? // 可复现性
  bugStepsToReproduce String? // 复现步骤
  bugEnvironment    String? // 环境信息
  bugExpectedResult String? // 预期结果
  bugActualResult   String? // 实际结果

  // 待办事项（结构化 JSON）
  todoItems         Json?

  // 里程碑关联
  milestoneId       String?

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  iteration       Iteration?       @relation(fields: [iterationId], references: [id], onDelete: SetNull)
  parentTask      Task?            @relation("TaskToSubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subTasks        Task[]           @relation("TaskToSubTasks")
  assignee        User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter        User?            @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  dependencies    TaskDependency[] @relation("TaskDeps")
  blockedBy       TaskDependency[] @relation("TaskBlockedBy")
  taskTags        TaskTag[]
  activities      TaskActivity[]
  milestoneTasks  MilestoneTask[]
  aiConversations AIConversation[]
  aiWorkflowRuns  AIWorkflowRun[]
  executionRuns   ExecutionRun[]

  @@index([projectId], name: "idx_tasks_project_id")
  @@index([projectId, status], name: "idx_tasks_project_id_status")
  @@index([assigneeId, status], name: "idx_tasks_assignee_id_status")
  @@index([iterationId], name: "idx_tasks_iteration_id")
  @@index([parentTaskId], name: "idx_tasks_parent_task_id")
  @@index([type], name: "idx_tasks_type")
  @@index([milestoneId], name: "idx_tasks_milestone_id")
  @@index([severity], name: "idx_tasks_severity")
}

model TaskDependency {
  id              String   @id @default(cuid())
  projectId       String
  taskId          String
  dependsOnTaskId String
  type            String // 'blocks' | 'relates'
  createdAt       DateTime @default(now())

  task          Task @relation("TaskDeps", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("TaskBlockedBy", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId], name: "idx_task_dependencies_task_id")
  @@index([dependsOnTaskId], name: "idx_task_dependencies_depends_on_task_id")
}

model TaskTag {
  taskId    String
  tagId     String
  projectId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId], name: "idx_task_tags_tag_id")
}

model TaskActivity {
  id        String   @id @default(cuid())
  projectId String
  taskId    String
  actorId   String?
  type      String // 'status_changed' | 'comment' | 'field_changed' | 'linked_git' | 'ai_suggestion_applied' | 'plugin_event'
  timestamp DateTime @default(now())
  summary   String?
  detail    Json?
  source    String? // 'system' | 'user' | 'plugin:<id>' | 'ai'
  metadata  Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, timestamp], name: "idx_task_activities_task_id_timestamp")
  @@index([projectId], name: "idx_task_activities_project_id")
  @@index([actorId], name: "idx_task_activities_actor_id")
}

model TaskTemplate {
  id          String   @id @default(cuid())
  projectId   String?
  name        String
  description String?
  category    String? // 'bug-fix' | 'feature' | 'release' | etc.
  items       TaskTemplateItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId], name: "idx_task_templates_project_id")
}

model TaskTemplateItem {
  id         String  @id @default(cuid())
  templateId String
  title      String
  description String?
  status     String?
  priority   String?
  estimate   Float?
  parentItemId String? // For hierarchical templates

  template TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId], name: "idx_task_template_items_template_id")
}

// Phase3 AIHub models
model AIModelConfig {
  id              String   @id @default(cuid())
  name            String
  provider        String
  taskTypes       Json?
  maxTokens       Int?
  costPer1kTokens Float?
  enabled         Boolean  @default(true)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([provider], name: "idx_ai_model_configs_provider")
  @@index([enabled], name: "idx_ai_model_configs_enabled")
}

model AIConversation {
  id        String   @id @default(cuid())
  projectId String?
  taskId    String?
  title     String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metadata  Json?

  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  messages  AIMessage[]
  usageLogs AIUsageLog[]

  @@index([projectId], name: "idx_ai_conversations_project_id")
  @@index([taskId], name: "idx_ai_conversations_task_id")
  @@index([createdBy], name: "idx_ai_conversations_created_by")
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  modelName      String?
  tokens         Int?
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt], name: "idx_ai_messages_conversation_id_created_at")
}

model AIWorkflowDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  definition  Json
  createdBy   String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs AIWorkflowRun[]
  steps AIWorkflowStep[]

  @@index([key], name: "idx_ai_workflow_definitions_key")
}

model AIWorkflowStep {
  id         String   @id @default(cuid())
  workflowId String
  stepType   String
  config     Json
  order      Int
  createdAt  DateTime @default(now())

  workflow AIWorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, order], name: "idx_ai_workflow_steps_workflow_id_order")
}

model AIWorkflowRun {
  id          String    @id @default(cuid())
  workflowId  String
  projectId   String?
  taskId      String?
  triggerType String
  status      String
  input       Json?
  output      Json?
  stepsState  Json?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workflow  AIWorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  project   Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?                @relation(fields: [taskId], references: [id], onDelete: SetNull)
  usageLogs AIUsageLog[]

  @@index([workflowId], name: "idx_ai_workflow_runs_workflow_id")
  @@index([projectId], name: "idx_ai_workflow_runs_project_id")
  @@index([taskId], name: "idx_ai_workflow_runs_task_id")
  @@index([status], name: "idx_ai_workflow_runs_status")
}

model AIUsageLog {
  id               String   @id @default(cuid())
  userId           String?
  projectId        String?
  taskId           String?
  conversationId   String?
  workflowRunId    String?
  modelName        String
  provider         String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCost    Float?
  requestPayload   Json?
  responseMetadata Json?
  createdAt        DateTime @default(now())

  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  workflowRun  AIWorkflowRun?  @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)

  @@index([userId], name: "idx_ai_usage_logs_user_id")
  @@index([projectId], name: "idx_ai_usage_logs_project_id")
  @@index([modelName, createdAt], name: "idx_ai_usage_logs_model_name_created_at")
}

// Phase5 Integration models
model IntegrationConfig {
  id          String   @id @default(cuid())
  provider    String   // 'github' | 'gitlab' | 'jira' | 'linear' | 'slack' | 'discord' | etc.
  scope       String   // 'global' | 'project'
  projectId   String?
  name        String
  enabled     Boolean  @default(true)
  configJson  Json     // Encrypted sensitive data (API tokens, secrets, etc.)
  status      String?  // 'connected' | 'disconnected' | 'error'
  lastSyncAt  DateTime?
  errorMessage String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  @@index([provider], name: "idx_integration_configs_provider")
  @@index([projectId], name: "idx_integration_configs_project_id")
  @@index([scope, provider], name: "idx_integration_configs_scope_provider")
}

model ExternalIssueLink {
  id          String   @id @default(cuid())
  projectId   String
  taskId      String?
  provider    String
  externalId  String
  url         String
  summary     String?
  status      String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([projectId], name: "idx_external_issue_links_project_id")
  @@index([taskId], name: "idx_external_issue_links_task_id")
  @@index([provider], name: "idx_external_issue_links_provider")
}

model WebhookEventLog {
  id          String   @id @default(cuid())
  provider    String
  eventType   String
  payload     Json
  signature   String?
  processed   Boolean  @default(false)
  errorMessage String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([provider, createdAt], name: "idx_webhook_event_logs_provider_created_at")
  @@index([processed], name: "idx_webhook_event_logs_processed")
}

// Phase5 Notification models
model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // 'task.assigned' | 'task.statusChanged' | 'ci.build.failed' | etc.
  title       String
  body        String?
  projectId   String?
  taskId      String?
  channels    Json     // ['in-app', 'email', 'slack'] - channels this notification was sent to
  status      String   // 'unread' | 'read'
  readAt      DateTime?
  payloadJson Json?    // Additional event data
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, status], name: "idx_notifications_user_id_status")
  @@index([userId, createdAt], name: "idx_notifications_user_id_created_at")
  @@index([projectId], name: "idx_notifications_project_id")
  @@index([taskId], name: "idx_notifications_task_id")
  @@index([type], name: "idx_notifications_type")
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  eventType String
  channels  String
  digestFrequency String?
  quietHoursStart String?
  quietHoursEnd String?
  quietHoursTimezone String?
  enabled   Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

  // Phase4: Plugin models
  model Plugin {
    id          String   @id @default(uuid())
    name        String
    version     String
    description String?
    manifest    Json
    enabled     Boolean  @default(true)
    config      Json?
    metadata    Json?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    permissions PluginPermission[]

    @@index([name], name: "idx_plugins_name")
    @@index([enabled], name: "idx_plugins_enabled")
  }

  model PluginPermission {
    id        String   @id @default(uuid())
    pluginId  String
    permission String
    granted   Boolean  @default(false)
    metadata  Json?
    createdAt DateTime @default(now())

    plugin    Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

    @@index([pluginId, permission], name: "idx_plugin_permissions_plugin_id_permission")
  }

// Phase4 Git models
model Repository {
  id            String   @id @default(cuid())
  projectId    String
  name         String
  localPath    String?
  remoteUrl    String?
  role         String?
  defaultBranch String?
  provider     String?
  workspacePath String? // Project workspace path
  gitConfig    Json?   // Git config from .git/config
  validationStatus String? // 'valid' | 'invalid' | 'unknown'
  validationError  String?
  lastValidatedAt DateTime?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commits       Commit[]
  pullRequests  PullRequest[]
  terminalSessions TerminalSession[]
  commandExecutions GitCommandExecution[]

  @@index([projectId], name: "idx_repositories_project_id")
  @@index([provider], name: "idx_repositories_provider")
  @@index([validationStatus], name: "idx_repositories_validation_status")
}

model Commit {
  id            String   @id @default(cuid())
  repoId        String
  hash          String
  authorName    String
  authorEmail   String?
  authorDate    DateTime
  committerName String?
  committerEmail String?
  committerDate DateTime?
  message       String
  parentHashes  Json?
  metadata      Json?

  repo   Repository    @relation(fields: [repoId], references: [id], onDelete: Cascade)
  files  CommitFile[]

  @@unique([repoId, hash], name: "idx_commits_repo_hash")
  @@index([repoId, authorDate], name: "idx_commits_repo_id_author_date")
}

model CommitFile {
  id        String   @id @default(cuid())
  commitId  String
  path      String
  status    String
  oldPath   String?
  additions Int?
  deletions Int?
  changes   Int?
  metadata  Json?

  commit Commit @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@index([commitId], name: "idx_commit_files_commit_id")
  @@index([path], name: "idx_commit_files_path")
}

model PullRequest {
  id           String   @id @default(cuid())
  repoId       String
  externalId   String
  title        String
  description  String?
  author       String
  sourceBranch String
  targetBranch String
  status       String
  labels       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  mergedAt     DateTime?
  metadata     Json?

  repo    Repository            @relation(fields: [repoId], references: [id], onDelete: Cascade)
  reviews PullRequestReview[]

  @@unique([repoId, externalId], name: "idx_pull_requests_repo_external")
  @@index([repoId, status], name: "idx_pull_requests_repo_id_status")
}

model PullRequestReview {
  id         String   @id @default(cuid())
  prId       String
  reviewerId String?
  type       String
  state      String
  summary    String?
  comments   Json?
  createdAt  DateTime @default(now())
  metadata   Json?

  pr PullRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@index([prId], name: "idx_pr_reviews_pr_id")
  @@index([reviewerId], name: "idx_pr_reviews_reviewer_id")
}

// Phase4 Terminal models
model TerminalSession {
  id        String   @id @default(cuid())
  projectId String?
  repoId    String?
  name      String?
  shell     String?
  cwd       String?
  createdBy String
  status    String
  createdAt DateTime @default(now())
  closedAt  DateTime?
  metadata  Json?

  project  Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  repo     Repository?        @relation(fields: [repoId], references: [id], onDelete: SetNull)
  commands CommandExecution[]

  @@index([projectId], name: "idx_terminal_sessions_project_id")
  @@index([createdBy], name: "idx_terminal_sessions_created_by")
  @@index([status], name: "idx_terminal_sessions_status")
}

model CommandExecution {
  id        String   @id @default(cuid())
  sessionId String
  command   String
  args      Json?
  env       Json?
  startTime DateTime @default(now())
  endTime   DateTime?
  exitCode  Int?
  status    String
  outputRef String?
  metadata  Json?

  session TerminalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, startTime], name: "idx_command_executions_session_id_start_time")
  @@index([status], name: "idx_command_executions_status")
}

// Phase4 Git command execution audit log
model GitCommandExecution {
  id        String   @id @default(cuid())
  repoId    String
  userId    String
  command   String
  args      Json?
  exitCode  Int?
  stdout    String?
  stderr    String?
  duration  Int?     // milliseconds
  executedAt DateTime @default(now())
  metadata  Json?

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, executedAt], name: "idx_git_command_executions_repo_id_executed_at")
  @@index([userId], name: "idx_git_command_executions_user_id")
}

// Phase4 Project workspace configuration
model ProjectWorkspace {
  id              String   @id @default(cuid())
  projectId       String   @unique
  localPath       String?
  remoteUrl       String?
  autoClone       Boolean  @default(false)
  validatedAt     DateTime?
  validationStatus String? // 'valid' | 'invalid' | 'unknown'
  validationError  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  metadata        Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], name: "idx_project_workspaces_project_id")
  @@index([validationStatus], name: "idx_project_workspaces_validation_status")
}

// New tables for Project enhanced features
model ExternalProjectLink {
  id                  String   @id @default(cuid())
  projectId           String
  provider            String   // 'github_projects' | 'linear' | 'jira'
  externalProjectId   String
  externalProjectUrl  String
  syncConfig          Json?
  lastSyncAt          DateTime?
  syncStatus          String   @default("active") // 'active' | 'paused' | 'error'
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, provider])
  @@index([projectId], name: "idx_external_project_links_project_id")
  @@index([provider], name: "idx_external_project_links_provider")
}

model ProjectDocLink {
  id          String   @id @default(cuid())
  projectId   String
  label       String
  url         String
  type        String   // 'wiki' | 'spec' | 'design' | 'other'
  description String?
  aiIndexed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], name: "idx_project_doc_links_project_id")
  @@index([aiIndexed], name: "idx_project_doc_links_ai_indexed")
}

model ProjectApiDocLink {
  id          String   @id @default(cuid())
  projectId   String
  label       String
  url         String
  type        String   // 'openapi' | 'apifox' | 'postman' | 'other'
  description String?
  aiIndexed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], name: "idx_project_api_doc_links_project_id")
  @@index([aiIndexed], name: "idx_project_api_doc_links_ai_indexed")
}

model ProjectHealthSnapshot {
  id          String   @id @default(cuid())
  projectId   String
  date        String   // 日期字符串 YYYY-MM-DD 格式
  healthScore Int
  breakdown   Json     // 各维度得分明细
  computedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, date], name: "idx_project_health_snapshots_project_id_date")
  @@index([date], name: "idx_project_health_snapshots_date")
}

model ProjectAIContext {
  id               String   @id @default(cuid())
  projectId        String   @unique
  techStack        Json?    // string[]
  languages        Json?    // string[]
  frameworks       Json?    // string[]
  domainTags       Json?    // string[]
  teamSizeCategory String?  // 'solo' | 'small' | 'medium' | 'large'
  lifecyclePhase   String?  // 'inception' | 'development' | 'maintenance' | 'sunset'
  complexityLevel  String?  // 'low' | 'medium' | 'high' | 'critical'
  riskIndicators   Json?    // { overdueTaskRatio, blockedTaskCount, velocityTrend, ciFailureRate }
  healthScore      Int?
  autoSummary      String?
  lastComputedAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], name: "idx_project_ai_contexts_project_id")
}

// ==================== Document Core Models ====================

// 文档主模型
model Document {
  id          String    @id @default(cuid())
  title       String
  content     String    @default("")
  summary     String?
  category    String    @default("custom") // requirement|design|api|testing|guide|custom
  status      String    @default("draft") // draft|reviewing|published|rejected
  folderId    String?
  projectId   String?
  authorId    String
  wordCount   Int       @default(0)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  sections    DocumentSection[]
  versions    DocumentVersion[]
  links       DocumentTaskLink[]
  references  DocumentReference[]
  approvals   DocumentApproval[]
  folder      DocumentFolder? @relation("FolderDocuments", fields: [folderId], references: [id])
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tags        DocumentTag[]

  @@index([folderId], name: "idx_documents_folder_id")
  @@index([projectId], name: "idx_documents_project_id")
  @@index([authorId], name: "idx_documents_author_id")
  @@index([status], name: "idx_documents_status")
  @@index([category], name: "idx_documents_category")
  @@index([isDeleted], name: "idx_documents_is_deleted")
}

// 文档目录（文件夹）
model DocumentFolder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  projectId String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    DocumentFolder? @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocumentFolder[] @relation("FolderChildren")
  documents Document[]       @relation("FolderDocuments")

  @@index([parentId], name: "idx_document_folders_parent_id")
  @@index([projectId], name: "idx_document_folders_project_id")
}

// 文档审批
model DocumentApproval {
  id          String    @id @default(cuid())
  documentId  String
  status      String    @default("pending") // pending|approved|rejected
  submitterId String
  approverId  String?
  comment     String?
  version     String?   // 审批时的版本号
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId], name: "idx_document_approvals_document_id")
  @@index([status], name: "idx_document_approvals_status")
  @@index([submitterId], name: "idx_document_approvals_submitter")
}

// ==================== Document Enhance Models ====================

// 文档章节
model DocumentSection {
  id         String   @id @default(cuid())
  documentId String
  title      String
  level      Int      @default(1)  // 1-6 对应 h1-h6
  anchor     String
  content    String?
  order      Int      @default(0)
  parentId   String?
  wordCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document   Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  taskLinks  DocumentTaskLink[]

  @@index([documentId], name: "idx_document_sections_document_id")
  @@index([documentId, order], name: "idx_document_sections_order")
}

// 文档任务关联
model DocumentTaskLink {
  id         String   @id @default(cuid())
  documentId String?
  sectionId  String?
  taskId     String
  projectId  String
  linkType   String   @default("references")  // references | blocks | relates | implements
  note       String?
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  section  DocumentSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([documentId], name: "idx_document_task_links_document_id")
  @@index([sectionId], name: "idx_document_task_links_section_id")
  @@index([taskId], name: "idx_document_task_links_task_id")
  @@index([projectId], name: "idx_document_task_links_project_id")
}

// 文档版本
model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  version      String
  content      String
  sectionsJson String?
  summary      String?
  wordCount    Int      @default(0)
  createdBy    String
  createdAt    DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId], name: "idx_document_versions_document_id")
  @@unique([documentId, version], name: "uniq_document_version")
}

// 文档引用（用于上下文追踪）
model DocumentReference {
  id         String   @id @default(cuid())
  sourceType String
  sourceId   String
  documentId String
  sectionId  String?
  anchor     String?
  context    String?
  createdBy  String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([sourceType, sourceId], name: "idx_document_references_source")
  @@index([documentId], name: "idx_document_references_document_id")
}

// ==================== v2 Runtime Layer ====================

/// Local Runtime 节点身份（长期存在，绑定到用户+设备）
model Runtime {
  id              String   @id @default(cuid())
  userId          String
  deviceId        String
  displayName     String?
  hostPlatform    String?  // darwin | win32 | linux
  runtimeVersion  String?
  protocolVersion String   @default("1.0.0")
  status          String   @default("offline") // online | offline | unreachable | disabled
  lastSeenAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  metadata        Json?

  sessions   RuntimeSession[]
  cliSessions CliSession[]

  @@unique([userId, deviceId])
  @@index([userId], name: "idx_runtimes_user_id")
  @@index([status], name: "idx_runtimes_status")
}

/// Runtime 连接会话（短生命周期）
model RuntimeSession {
  id               String   @id @default(cuid())
  runtimeId        String
  sessionTokenHash String
  status           String   @default("active") // active | expired | disconnected | revoked
  connectionMode   String   @default("cli") // cli | mcp | api
  connectedAt      DateTime @default(now())
  disconnectedAt   DateTime?
  lastHeartbeatAt  DateTime @default(now())
  metadata         Json?

  runtime      Runtime                    @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  capabilities RuntimeCapabilitySnapshot[]

  @@index([runtimeId], name: "idx_runtime_sessions_runtime_id")
  @@index([status], name: "idx_runtime_sessions_status")
  @@index([lastHeartbeatAt], name: "idx_runtime_sessions_last_heartbeat")
}

/// Runtime 上报的能力快照
model RuntimeCapabilitySnapshot {
  id               String   @id @default(cuid())
  runtimeSessionId String
  workspaceRoots   Json?    // 可用的工作区路径列表
  cliProviders     Json?    // 检测到的 CLI provider（codex, claude-code）
  capabilityFlags  Json?    // 能力标记
  reportedAt       DateTime @default(now())

  runtimeSession RuntimeSession @relation(fields: [runtimeSessionId], references: [id], onDelete: Cascade)

  @@index([runtimeSessionId], name: "idx_runtime_caps_session_id")
}

// ==================== v2 Execution Core ====================

/// 统一执行实例（替代 v1 AIWorkflowRun）
model ExecutionRun {
  id              String   @id @default(cuid())
  projectId       String
  taskId          String?
  subjectType     String   // human | platform_ai_member | external_agent
  subjectId       String   // Agent ID 或 User ID
  identitySource  String   // internal | mcp | cli | api | plugin
  goal            String   // 执行目标描述
  role            String?  // 项目角色（PM, Frontend Dev, Backend Dev...）
  level           String?  // Intern | Junior | Intermediate | Senior | Lead | Architect
  status          String   @default("draft") // draft | planned | in_progress | pending_approval | completed | failed | blocked | superseded
  input           Json?    // 执行输入
  output          Json?    // 执行输出
  errorDetail     Json?    // 错误详情
  contextSnapshotId String? // ContextPackSnapshot 关联
  startedAt       DateTime?
  completedAt     DateTime?
  terminatedAt    DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  metadata        Json?

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  approvals  ApprovalRequest[]
  steps      ExecutionStep[]
  artifacts  ExecutionArtifact[]
  bindings   CliExecutionBinding[]
  context    ContextPackSnapshot?

  @@index([projectId], name: "idx_execution_runs_project_id")
  @@index([taskId], name: "idx_execution_runs_task_id")
  @@index([subjectType, subjectId], name: "idx_execution_runs_subject")
  @@index([status], name: "idx_execution_runs_status")
  @@index([createdAt], name: "idx_execution_runs_created_at")
}

/// 审批请求（对写操作的统一审批门禁）
model ApprovalRequest {
  id              String    @id @default(cuid())
  executionRunId  String
  projectId       String
  taskId          String?
  requestedAction String    // 需要审批的操作描述
  actionType      String    // tool_call | git_write | terminal_exec | external_sync | status_change
  riskLevel       String    // read | write | high_risk
  reason          String?
  status          String    @default("pending") // pending | approved | rejected | expired | cancelled | auto_approved
  approverPolicy  String?   // 谁可以审批（role:level 格式）
  approvedBy      String?
  rejectedBy      String?
  resolutionNote  String?
  requestedAt     DateTime  @default(now())
  resolvedAt      DateTime?
  expiresAt       DateTime?
  metadata        Json?

  executionRun ExecutionRun @relation(fields: [executionRunId], references: [id], onDelete: Cascade)
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([executionRunId], name: "idx_approval_requests_execution_run_id")
  @@index([status], name: "idx_approval_requests_status")
  @@index([projectId, status], name: "idx_approval_requests_project_status")
  @@index([requestedAt], name: "idx_approval_requests_requested_at")
}

/// 执行步骤记录
model ExecutionStep {
  id             String   @id @default(cuid())
  executionRunId String
  stepType       String   // tool_call | observation | thinking | approval_gate | error | result
  sequence       Int
  name           String?
  input          Json?
  output         Json?
  status         String   @default("pending") // pending | running | completed | failed | skipped
  startedAt      DateTime?
  completedAt    DateTime?
  duration       Int?     // 毫秒
  metadata       Json?

  executionRun ExecutionRun @relation(fields: [executionRunId], references: [id], onDelete: Cascade)

  @@index([executionRunId, sequence], name: "idx_execution_steps_run_sequence")
}

/// 执行产物/证据
model ExecutionArtifact {
  id             String   @id @default(cuid())
  executionRunId String
  stepId         String?
  artifactType   String   // code_diff | command_output | file_path | screenshot | log | report
  name           String
  content        String?  // 内联内容（小数据）
  storageRef     String?  // 存储引用（大数据）
  metadata       Json?
  createdAt      DateTime @default(now())

  executionRun ExecutionRun @relation(fields: [executionRunId], references: [id], onDelete: Cascade)

  @@index([executionRunId], name: "idx_execution_artifacts_run_id")
  @@index([artifactType], name: "idx_execution_artifacts_type")
}

/// 结构化上下文快照
model ContextPackSnapshot {
  id             String   @id @default(cuid())
  executionRunId String   @unique
  projectId      String
  taskId         String?
  payload        Json     // 结构化上下文数据
  sourceSummary  Json?    // 包含哪些上下文源
  freshness      String   @default("realtime") // realtime | cached | stale
  createdAt      DateTime @default(now())

  executionRun ExecutionRun @relation(fields: [executionRunId], references: [id], onDelete: Cascade)

  @@index([projectId], name: "idx_context_pack_snapshots_project_id")
  @@index([taskId], name: "idx_context_pack_snapshots_task_id")
}

// ==================== v2 CLI Adapter Layer ====================

/// CLI Provider 会话（Codex / Claude Code）
model CliSession {
  id               String   @id @default(cuid())
  runtimeId        String
  runtimeSessionId String?
  providerId       String   // codex | claude-code
  workspaceRoot    String
  rawSessionRef    String?
  status           String   @default("active") // active | idle | terminated | error
  startedAt        DateTime @default(now())
  endedAt          DateTime?
  lastActiveAt     DateTime @default(now())
  metadata         Json?

  runtime  Runtime               @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  bindings CliExecutionBinding[]

  @@index([runtimeId], name: "idx_cli_sessions_runtime_id")
  @@index([providerId], name: "idx_cli_sessions_provider_id")
  @@index([status], name: "idx_cli_sessions_status")
}

/// 执行与 CLI 会话的绑定
model CliExecutionBinding {
  id             String   @id @default(cuid())
  executionRunId String
  cliSessionId   String
  runtimeId      String
  providerId     String   // codex | claude-code
  workspaceRoot  String
  bindingMode    String   @default("one-time") // one-time | session-reuse
  status         String   @default("active") // active | completed | failed | terminated
  createdAt      DateTime @default(now())

  executionRun ExecutionRun @relation(fields: [executionRunId], references: [id], onDelete: Cascade)
  cliSession   CliSession  @relation(fields: [cliSessionId], references: [id], onDelete: Cascade)

  @@index([executionRunId], name: "idx_cli_exec_bindings_run_id")
  @@index([cliSessionId], name: "idx_cli_exec_bindings_session_id")
}


// ============ Phase 4: 短 ID + 模块代码 ============

model ProjectModule {
  id          String   @id @default(cuid())
  projectId   String
  code        String   // 'PF', 'UI', 'BE' 等
  name        String   // "平台功能", "用户界面" 等
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, code])
  @@index([projectId])
}

model ProjectSequence {
  projectId String   @id
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
