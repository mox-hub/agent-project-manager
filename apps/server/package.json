    "octokit": "^5.0.5",
    "p-retry": "^4.6.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "simple-git": "^3.36.0",
    "socket.io": "^4.8.1",
    "winston": "^3.19.0",
    "zod": "^4.5.4"
