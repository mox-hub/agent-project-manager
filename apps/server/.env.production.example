# ===========================================
# Agent Project Manager - Server Production Config
# ===========================================
# Copy this file to .env and fill in the values before running in production.

# App mode: standalone (desktop) | server (multi-user) | client (connected)
APP_MODE=standalone

# Server
PORT=4300

# Database (SQLite — file path)
DATABASE_URL=file:./data/agent-project-manager.db

# JWT
JWT_SECRET=change-me-to-a-random-secret

# Frontend static hosting (set when APP_MODE=standalone)
# FRONTEND_DIST_DIR=../frontend/dist

# Uploads
UPLOAD_DIR=./uploads

# CORS — comma-separated origins (empty = same-origin only)
# ALLOWED_ORIGINS=http://localhost:5173

# Integration encryption key (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
INTEGRATION_ENCRYPTION_KEY=change-me-to-a-random-64-char-hex-string

# Prisma
PRISMA_CLIENT_ENGINE_TYPE=library

# Logging
# LOG_LEVEL=info
