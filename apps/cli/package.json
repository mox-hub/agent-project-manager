{
  "name": "@ordo/cli",
  "version": "0.1.0",
  "description": "Ordo CLI：瘦客户端（ordo）+ 常驻 runtime 守护进程（ordo-runtime）",
  "private": true,
  "license": "UNLICENSED",
  "bin": {
    "apm": "dist/index.js",
    "apm-runtime": "dist/runtime/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "cd ../.. && pnpm --filter @ordo/shared build",
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.build.json --noEmit",
    "pretest": "cd ../.. && pnpm --filter @ordo/shared build",
    "test": "vitest run"
  },
  "dependencies": {
    "@ordo/shared": "workspace:*",
    "commander": "^12.1.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "typescript": "^5.1.3",
    "vitest": "catalog:"
  }
}
