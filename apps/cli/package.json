{
  "name": "@apm/cli",
  "version": "0.1.0",
  "description": "Agent Project Manager CLI：瘦客户端（apm）+ 常驻 runtime 守护进程（apm-runtime）",
  "private": true,
  "license": "UNLICENSED",
  "bin": {
    "apm": "dist/index.js",
    "apm-runtime": "dist/runtime/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "cd ../.. && pnpm --filter @apm/shared build",
