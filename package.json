{
  "name": "agent-project-manager",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/server\" --filter \"./apps/frontend\" run dev",
    "dev:server": "pnpm --filter \"./apps/server\" dev",
    "dev:frontend": "pnpm --filter \"./apps/frontend\" dev",
    "desktop:dev": "pnpm --filter \"./apps/desktop\" desktop:dev",
    "desktop:pack": "pnpm --filter \"./apps/desktop\" desktop:pack",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:watch": "pnpm --parallel --filter \"./apps/server\" --filter \"./apps/frontend\" run test:watch",
    "test:coverage": "pnpm --parallel --filter \"./apps/server\" --filter \"./apps/frontend\" run test:coverage",
    "test:ui": "pnpm --filter \"./apps/frontend\" run test:ui",
    "test:e2e": "pnpm --filter \"./apps/server\" run test:e2e",
    "check:docs-sync": "node scripts/check-doc-sync.mjs",
    "check:doc-coverage": "node scripts/check-doc-coverage.mjs",
    "quality:gate": "pnpm type-check && pnpm lint && turbo run test && pnpm contract:check && pnpm --filter \"./apps/server\" run test:e2e && pnpm api:audit --min=95 && pnpm check:docs-sync",
    "gate:quick": "node scripts/gate.mjs",
    "gate:full": "pnpm quality:gate",
    "wt:check": "node scripts/worktree-deps.mjs check",
    "wt:link": "node scripts/worktree-deps.mjs link",
    "report:weekly-governance": "node scripts/generate-weekly-governance-report.mjs",
    "prepare": "husky",
    "contract:export": "pnpm --filter ./apps/server run contract:export",
    "contract:generate": "openapi-typescript ./openapi.json -o ./apps/frontend/src/infrastructure/api-client/generated/api-types.gen.ts && openapi-typescript ./openapi.json -o ./packages/apm-shared/src/generated/api-types.gen.ts",
    "contract:check": "node scripts/contract-check.mjs",
    "check:cli-contract": "node scripts/check-cli-contract.mjs",
    "check:contract-convention": "node scripts/check-contract-convention.mjs",
    "api:audit": "node scripts/api-audit.mjs",
    "knip": "knip",
    "check:i18n-sync": "node scripts/check-i18n-sync.mjs",
    "check:boundaries": "pnpm --filter server exec depcruise src --config ../../.dependency-cruiser.cjs"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.2.0",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.5.0",
    "openapi-typescript": "^7",
    "turbo": "^2.10.12"
  }
}
